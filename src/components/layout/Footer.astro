---
const currentYear = new Date().getFullYear();
---

<footer class="bg-slate-900 text-slate-300 border-t border-slate-800 mt-16 sm:mt-20 no-print">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-14">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 lg:gap-10">
      
      <!-- Col 1: Brand & Positioning -->
      <div class="space-y-4">
        <a
          href="/"
          class="inline-block focus:outline-hidden focus:ring-2 focus:ring-emerald-500 rounded-lg transition-opacity hover:opacity-95"
          aria-label="CubicYardKit.com Home"
        >
          <img
            src="/cubicYardKit-footer-dark.svg"
            alt="CubicYardKit.com"
            width="192"
            height="40"
            class="h-9 w-auto object-contain"
            loading="lazy"
          />
        </a>
        <p class="text-xs text-slate-400 leading-relaxed">
          Commercial-grade material quantity estimation and integrated project planning for US homeowners, earthwork contractors, and landscapers.
        </p>
        <div class="pt-1">
          <span class="text-[10px] font-bold uppercase tracking-wider text-emerald-400 bg-emerald-950/80 border border-emerald-500/30 px-2 py-0.5 rounded">
            ASTM · ACI · NCMA · ICPI
          </span>
        </div>
      </div>

      <!-- Col 2: Core Calculators -->
      <div>
        <h4 class="text-xs font-bold uppercase tracking-wider text-slate-200 mb-3.5 font-display">Calculators</h4>
        <ul class="space-y-2 text-xs">
          <li><a href="/" class="hover:text-white transition-colors">Cubic Yard Calculator</a></li>
          <li><a href="/gravel-calculator/" class="hover:text-white transition-colors">Gravel & Pea Gravel</a></li>
          <li><a href="/dirt-calculator/" class="hover:text-white transition-colors">Fill Dirt & Soil Volume</a></li>
          <li><a href="/topsoil-calculator/" class="hover:text-white transition-colors">Topsoil Coverage & Turf</a></li>
          <li><a href="/concrete-calculator/" class="hover:text-white transition-colors">Concrete Slabs & Footings</a></li>
          <li><a href="/concrete-block-calculator/" class="hover:text-white transition-colors">Concrete Block (CMU) Walls</a></li>
        </ul>
      </div>

      <!-- Col 3: Planning Tools -->
      <div>
        <h4 class="text-xs font-bold uppercase tracking-wider text-slate-200 mb-3.5 font-display">Project Tools</h4>
        <ul class="space-y-2 text-xs">
          <li><a href="/planner/" class="text-emerald-400 font-medium hover:text-emerald-300 transition-colors">Patio Material Planner</a></li>
          <li><a href="/quote-comparison/" class="hover:text-white transition-colors">Supplier Quote Comparison</a></li>
          <li><a href="/gravel-calculator/#formula" class="hover:text-white transition-colors">Gravel Tonnage Formulas</a></li>
          <li><a href="/concrete-calculator/#bags" class="hover:text-white transition-colors">Concrete Bag Yield Charts</a></li>
        </ul>
      </div>

      <!-- Col 4: Company & Legal (AdSense Mandatory Links) -->
      <div>
        <h4 class="text-xs font-bold uppercase tracking-wider text-slate-200 mb-3.5 font-display">Company & Legal</h4>
        <ul class="space-y-2 text-xs">
          <li><a href="/about/" class="hover:text-white transition-colors">About CubicYardKit</a></li>
          <li><a href="/contact/" class="hover:text-white transition-colors">Contact & Feedback</a></li>
          <li><a href="/disclaimer/" class="hover:text-white transition-colors">Estimating Disclaimer</a></li>
          <li><a href="/privacy/" class="hover:text-white transition-colors">Privacy & Cookie Policy</a></li>
          <li><a href="/terms/" class="hover:text-white transition-colors">Terms of Service</a></li>
        </ul>
      </div>

    </div>

    <!-- Sub-Footer Disclaimer & Copyright -->
    <div class="mt-10 pt-8 border-t border-slate-800 text-slate-400 text-[11px] leading-relaxed space-y-3">
      <p>
        <strong class="text-slate-300">Estimating Disclaimer:</strong> Calculations provided by CubicYardKit.com are mathematical approximations based on user inputs and published material densities. Actual jobsite requirements vary due to moisture content, mechanical compaction, subgrade irregularities, and supplier batch tolerances. Always verify quantities with your local materials supplier before ordering.
      </p>
      
      <div class="flex flex-col sm:flex-row items-center justify-between gap-3 text-slate-500 pt-2">
        <div>
          © {currentYear} CubicYardKit.com. All rights reserved. Built to US engineering standards.
        </div>
        <div class="flex flex-wrap gap-4 text-[11px]">
          <a href="/privacy/" class="hover:text-slate-300 transition-colors">Privacy</a>
          <span class="text-slate-700">·</span>
          <a href="/terms/" class="hover:text-slate-300 transition-colors">Terms</a>
          <span class="text-slate-700">·</span>
          <a href="/disclaimer/" class="hover:text-slate-300 transition-colors">Disclaimer</a>
          <span class="text-slate-700">·</span>
          <a href="/contact/" class="hover:text-slate-300 transition-colors">Contact</a>
        </div>
      </div>
    </div>

  </div>
</footer>

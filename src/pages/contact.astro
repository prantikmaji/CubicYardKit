---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/seo/Breadcrumbs.astro';

const seo = {
  title: 'Contact Us | CubicYardKit — Estimating Support & Feedback',
  description:
    'Get in touch with the CubicYardKit editorial and engineering team for calculation audits, regional aggregate density feedback, or tool inquiries.',
  canonicalUrl: 'https://cubicyardkit.com/contact/',
};

const breadcrumbs = [{ name: 'Contact Us', href: '/contact/' }];
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  canonicalUrl={seo.canonicalUrl}
  breadcrumbs={breadcrumbs}
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12">
    <Breadcrumbs items={breadcrumbs} />

    <!-- Hero Header -->
    <div class="relative overflow-hidden rounded-2xl bg-slate-900 border border-slate-800 p-6 sm:p-10 mb-10 text-white shadow-md">
      <div class="absolute -top-12 -right-12 w-80 h-80 bg-emerald-500/10 rounded-full blur-3xl pointer-events-none"></div>
      <div class="relative max-w-2xl">
        <div class="inline-flex items-center gap-2 bg-emerald-950/80 border border-emerald-500/40 rounded-full px-3 py-1 text-xs font-bold text-emerald-300 mb-3.5 shadow-xs">
          <span class="w-1.5 h-1.5 bg-emerald-400 rounded-full animate-pulse shadow-[0_0_8px_#34d399]"></span>
          Editorial Inquiries · Density Audits · Supplier Partnerships
        </div>
        <h1 class="text-3xl sm:text-4xl font-black text-white tracking-tight leading-tight mb-3">
          Contact Us
        </h1>
        <p class="text-sm sm:text-base text-slate-200 leading-relaxed">
          Have feedback on our calculations, regional quarry density variations to share, or partnership questions? Our engineering and editorial team is here to help.
        </p>
      </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 text-slate-800 text-sm">
      
      <!-- Left Column: Contact Methods & Channels (5 cols) -->
      <div class="lg:col-span-5 space-y-6">
        
        <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-2xs space-y-4">
          <h2 class="text-base font-bold text-slate-900">Direct Communication</h2>
          
          <div class="space-y-4 text-xs">
            <div class="flex items-start gap-3">
              <div class="w-8 h-8 rounded-lg bg-emerald-50 text-emerald-700 flex items-center justify-center shrink-0 border border-emerald-200">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                </svg>
              </div>
              <div>
                <span class="font-bold text-slate-900 block">General & Editorial Inquiries</span>
                <a href="mailto:contact@cubicyardkit.com" class="text-emerald-700 hover:underline font-mono text-[11px]">
                  contact@cubicyardkit.com
                </a>
                <p class="text-slate-500 text-[11px] mt-0.5">Tool questions, feedback & feature requests</p>
              </div>
            </div>

            <div class="flex items-start gap-3">
              <div class="w-8 h-8 rounded-lg bg-blue-50 text-blue-700 flex items-center justify-center shrink-0 border border-blue-200">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z" />
                </svg>
              </div>
              <div>
                <span class="font-bold text-slate-900 block">Calculation & Density Audits</span>
                <a href="mailto:math@cubicyardkit.com" class="text-blue-700 hover:underline font-mono text-[11px]">
                  math@cubicyardkit.com
                </a>
                <p class="text-slate-500 text-[11px] mt-0.5">Submit quarry scale slips or test verification data</p>
              </div>
            </div>

            <div class="flex items-start gap-3">
              <div class="w-8 h-8 rounded-lg bg-amber-50 text-amber-700 flex items-center justify-center shrink-0 border border-amber-200">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
              </div>
              <div>
                <span class="font-bold text-slate-900 block">Response Timelines</span>
                <p class="text-slate-600 text-[11px]">We review and respond to inquiries within 24 to 48 business hours (Monday–Friday, 9:00 AM – 5:00 PM EST).</p>
              </div>
            </div>
          </div>
        </div>

        <div class="p-5 rounded-2xl bg-slate-50 border border-slate-200 space-y-2 text-xs">
          <span class="font-bold text-slate-900 block">Contractor Field Audits</span>
          <p class="text-slate-600 leading-relaxed">
            Are you a quarry operator, ready-mix dispatcher, or excavation contractor with updated local density metrics for your region? We welcome verified certified weighmaster tickets and laboratory spec sheets.
          </p>
        </div>

      </div>

      <!-- Right Column: Interactive Inquiry Form (7 cols) -->
      <div class="lg:col-span-7">
        <div class="bg-white p-6 sm:p-8 rounded-2xl border border-slate-200 shadow-2xs space-y-5">
          <div>
            <h2 class="text-lg font-bold text-slate-900">Send Us a Message</h2>
            <p class="text-xs text-slate-500 mt-0.5">Fill out the form below and our team will get back to you promptly.</p>
          </div>

          <form id="contact-form" class="space-y-4 text-xs">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div class="space-y-1">
                <label for="contact-name" class="font-bold text-slate-700 uppercase tracking-wider text-[11px]">Your Name *</label>
                <input
                  type="text"
                  id="contact-name"
                  name="name"
                  required
                  placeholder="e.g. Mike Henderson"
                  class="w-full px-3 py-2 text-xs rounded-lg border border-slate-300 focus:outline-hidden focus:ring-2 focus:ring-emerald-600 focus:border-emerald-600"
                />
              </div>

              <div class="space-y-1">
                <label for="contact-email" class="font-bold text-slate-700 uppercase tracking-wider text-[11px]">Your Email *</label>
                <input
                  type="email"
                  id="contact-email"
                  name="email"
                  required
                  placeholder="mike@example.com"
                  class="w-full px-3 py-2 text-xs rounded-lg border border-slate-300 focus:outline-hidden focus:ring-2 focus:ring-emerald-600 focus:border-emerald-600"
                />
              </div>
            </div>

            <div class="space-y-1">
              <label for="contact-subject" class="font-bold text-slate-700 uppercase tracking-wider text-[11px]">Topic / Subject *</label>
              <select
                id="contact-subject"
                name="subject"
                required
                class="w-full px-3 py-2 text-xs rounded-lg border border-slate-300 bg-white focus:outline-hidden focus:ring-2 focus:ring-emerald-600 focus:border-emerald-600"
              >
                <option value="math-question">Calculation / Math Verification</option>
                <option value="density-data">Material Density / Quarry Feedback</option>
                <option value="bug-report">Bug Report / Website Issue</option>
                <option value="partnership">Commercial / Supplier Partnership</option>
                <option value="other">General Question</option>
              </select>
            </div>

            <div class="space-y-1">
              <label for="contact-message" class="font-bold text-slate-700 uppercase tracking-wider text-[11px]">Message *</label>
              <textarea
                id="contact-message"
                name="message"
                rows="5"
                required
                placeholder="Please describe your question, project details, or calculation feedback..."
                class="w-full px-3 py-2 text-xs rounded-lg border border-slate-300 focus:outline-hidden focus:ring-2 focus:ring-emerald-600 focus:border-emerald-600 leading-relaxed"
              ></textarea>
            </div>

            <button
              type="submit"
              class="w-full py-2.5 px-4 rounded-xl bg-emerald-700 hover:bg-emerald-800 text-white font-bold text-xs shadow-xs transition-colors cursor-pointer flex items-center justify-center gap-2"
            >
              <span>Submit Message</span>
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </button>

            <div id="form-success" class="hidden p-3 rounded-lg bg-emerald-50 border border-emerald-200 text-emerald-800 text-xs font-medium">
              Thank you! Your message has been received. Our editorial team will review your note and respond within 24–48 business hours.
            </div>
          </form>
        </div>
      </div>

    </div>
  </div>
</BaseLayout>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const successBox = document.getElementById('form-success');

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    if (successBox) {
      successBox.classList.remove('hidden');
      form.reset();
    }
  });
</script>

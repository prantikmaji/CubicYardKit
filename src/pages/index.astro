---
import BaseLayout from '../layouts/BaseLayout.astro';
import CubicYardCalculator from '../components/calc/CubicYardCalculator';
import SavedProjectsIsland from '../components/storage/SavedProjectsIsland';
import { KEYWORD_MAP } from '../data/keyword-map';

const seo = {
  title: 'Cubic Yard Calculator | Calculate Cubic Yards | CubicYardKit',
  description:
    'Calculate cubic yards, tonnage, and bags from length, width, and depth. Complete trade reference with material densities, formulas, compaction rates, and hauling specs.',
  canonicalUrl: 'https://cubicyardkit.com/',
};

const faqs = [
  {
    question: 'How do you calculate cubic yards from feet and inches?',
    answer:
      'To calculate cubic yards when dimensions are in feet and depth is in inches: multiply length in feet by width in feet, multiply by (depth in inches ÷ 12) to calculate total cubic feet, and divide the result by 27. Alternatively, use the direct shortcut: (Length in ft × Width in ft × Depth in inches) ÷ 324 = Cubic Yards. For example, a 20 ft by 10 ft patio poured at 4 inches depth equals (20 × 10 × 4) ÷ 324 = 2.47 cubic yards.',
  },
  {
    question: 'How many cubic feet are in one cubic yard?',
    answer:
      'There are exactly 27 cubic feet in one cubic yard. A cubic yard represents a three-dimensional cube measuring 3 feet wide, 3 feet long, and 3 feet deep (3 ft × 3 ft × 3 ft = 27 ft³). In liquid volume, 1 cubic yard equals approximately 201.97 US liquid gallons or 764.55 liters.',
  },
  {
    question: 'What is the formula to convert square feet directly into cubic yards?',
    answer:
      'Multiply your total surface area in square feet by the desired material thickness in inches, then divide by 324. Formula: Cubic Yards = (Square Feet × Depth in Inches) ÷ 324. This mathematical shortcut works because 1 cubic yard (27 cu ft) equals 324 square feet of coverage at exactly 1 inch thickness.',
  },
  {
    question: 'How much does a cubic yard of material weigh?',
    answer:
      'Weight depends entirely on material density and moisture content. One cubic yard of crushed #57 gravel weighs approximately 2,700 lbs (1.35 tons); dry screened topsoil weighs about 2,100 lbs (1.05 tons); wet excavated clay can exceed 2,600 lbs (1.3 tons); dense crusher run aggregate weighs 3,000 lbs (1.5 tons); and standard ready-mix wet concrete weighs roughly 4,050 lbs (2.025 tons).',
  },
  {
    question: 'How many wheelbarrows make a cubic yard?',
    answer:
      'A standard residential contractor wheelbarrow has a tray capacity of 3 cubic feet, requiring exactly 9 full level loads (27 ÷ 3 = 9) to move 1 cubic yard. Smaller residential consumer wheelbarrows (2 cubic feet) require 13.5 loads. Heavy-duty 6 cubic foot commercial landscaping wheelbarrows move 1 cubic yard in approximately 4.5 trips.',
  },
  {
    question: 'How many bags of concrete or gravel make 1 cubic yard?',
    answer:
      'For pre-bagged concrete: one 80-lb bag yields approximately 0.60 cubic feet, requiring 45 bags per cubic yard. One 60-lb bag yields approximately 0.45 cubic feet, requiring 60 bags per cubic yard. For standard pre-bagged gravel or soil sold in 0.5-cubic-foot bags (approx. 50 lbs), you need exactly 54 bags (27 ÷ 0.5) to equal 1 cubic yard.',
  },
  {
    question: 'What is the difference between a square yard and a cubic yard?',
    answer:
      'A square yard is a two-dimensional measurement of flat surface area (3 ft × 3 ft = 9 square feet), used for carpeting, sod rolls, and fabric. A cubic yard is a three-dimensional measurement of volume (3 ft × 3 ft × 3 ft = 27 cubic feet), used for bulk materials with depth like dirt, concrete, gravel, and mulch.',
  },
  {
    question: 'How many cubic yards can a standard pickup truck carry?',
    answer:
      'While a standard 6.5-foot or 8-foot pickup truck bed physically holds 1.5 to 2.5 cubic yards of volumetric space, payload weight is the limiting safety factor. A half-ton truck (F-150, Silverado 1500) has a typical payload limit of 1,500 to 2,000 lbs, accommodating only 0.5 to 0.75 cubic yards of heavy gravel or wet soil. Lightweight dry mulch (600–800 lbs/yd³) can safely fill the full 2 cubic yard bed capacity.',
  },
];

const toolCards = [
  {
    href: '/gravel-calculator/',
    title: 'Gravel & Pea Gravel',
    badge: 'Yards & Tons',
    desc: 'Estimate crushed stone, pea gravel, and driveway rock in cubic yards, tons, and 50-lb bags with quarry scaling.',
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />`,
    accentColor: 'border-t-slate-400 hover:border-green-500',
    hoverText: 'group-hover:text-green-700',
    iconBg: 'bg-slate-100',
    iconColor: 'text-slate-600',
  },
  {
    href: '/dirt-calculator/',
    title: 'Fill Dirt & Grading',
    badge: 'Settlement Factor',
    desc: 'Calculate subsoil excavation, grading volume, and 10-yard dump truckloads with mechanical compaction factors.',
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M3 14h18m-9-4v8m-7 0h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z" />`,
    accentColor: 'border-t-amber-300 hover:border-amber-500',
    hoverText: 'group-hover:text-amber-700',
    iconBg: 'bg-amber-50',
    iconColor: 'text-amber-600',
  },
  {
    href: '/topsoil-calculator/',
    title: 'Topsoil & Gardens',
    badge: 'Sq Ft Coverage',
    desc: 'Calculate screened topsoil volume for lawn leveling, new sod establishment, and raised planter bed blends.',
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z" />`,
    accentColor: 'border-t-green-300 hover:border-green-500',
    hoverText: 'group-hover:text-green-700',
    iconBg: 'bg-green-50',
    iconColor: 'text-green-600',
  },
  {
    href: '/concrete-calculator/',
    title: 'Concrete Slabs & Footings',
    badge: '80lb & 60lb Bags',
    desc: 'Order ready-mix truck yardage or calculate pre-mixed bagged concrete for slabs, post holes, and structural footings.',
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z" />`,
    accentColor: 'border-t-blue-300 hover:border-blue-500',
    hoverText: 'group-hover:text-blue-700',
    iconBg: 'bg-blue-50',
    iconColor: 'text-blue-600',
  },
  {
    href: '/concrete-block-calculator/',
    title: 'Concrete Block Walls',
    badge: 'CMU & Mortar',
    desc: 'Calculate standard 8x8x16 CMU blocks, window/door deductions, mortar bags, and structural core fill grout volume.',
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17V7m0 10a2 2 0 01-2 2H5a2 2 0 01-2-2V7a2 2 0 012-2h2a2 2 0 012 2m0 10a2 2 0 002 2h2a2 2 0 002-2M9 7a2 2 0 012-2h2a2 2 0 012 2m0 10V7m0 10a2 2 0 002 2h2a2 2 0 002-2V7a2 2 0 00-2-2h-2a2 2 0 00-2 2" />`,
    accentColor: 'border-t-slate-400 hover:border-slate-600',
    hoverText: 'group-hover:text-slate-700',
    iconBg: 'bg-slate-100',
    iconColor: 'text-slate-600',
  },
  {
    href: '/planner/',
    title: 'Project Material Planner',
    badge: 'Multi-Material Bill',
    desc: 'Estimate complete multi-layer paver patios with sub-base stone, bedding sand, edge restraints, and printable BOM.',
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01" />`,
    accentColor: 'border-t-emerald-500 hover:border-emerald-600',
    hoverText: 'group-hover:text-emerald-700',
    iconBg: 'bg-emerald-50',
    iconColor: 'text-emerald-700',
  },
];
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  canonicalUrl={seo.canonicalUrl}
  faqs={faqs}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-5 sm:pt-7 pb-14 sm:pb-20">

    <!-- Saved Projects in top-right corner on mobile -->
    <div class="flex justify-end mb-4 lg:hidden">
      <SavedProjectsIsland client:load />
    </div>

    <!-- Hero Banner — High contrast dark slate with emerald aura -->
    <div class="relative overflow-hidden rounded-2xl sm:rounded-3xl bg-slate-900 border border-slate-800 px-6 sm:px-8 lg:px-10 py-7 sm:py-9 lg:py-10 mb-8 sm:mb-10 text-white shadow-md">
      <div class="absolute -top-12 -right-12 w-96 h-96 bg-emerald-500/10 rounded-full blur-3xl pointer-events-none"></div>

      <div class="relative flex flex-wrap items-end justify-between gap-6 lg:gap-8">
        <div class="max-w-2xl">
          <div class="inline-flex items-center gap-2 bg-emerald-950/80 border border-emerald-500/40 rounded-full px-3.5 py-1 text-xs font-bold text-emerald-300 mb-3.5 sm:mb-4 shadow-xs">
            <span class="w-1.5 h-1.5 bg-emerald-400 rounded-full animate-pulse shadow-[0_0_8px_#34d399]"></span>
            Trade Estimating Platform · ASTM Bulk Densities · Zero Assumptions
          </div>

          <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black text-white tracking-tight leading-[1.08] mb-2.5 sm:mb-3">
            Cubic Yard<br class="hidden sm:block" /> Calculator
          </h1>
          <p class="text-sm sm:text-base text-slate-200 max-w-xl leading-relaxed">
            Calculate exact cubic yards, scale weight tonnage, and bag counts from length, width, and depth. Built to professional engineering standards for earthwork contractors, landscapers, and builders across the United States.
          </p>
        </div>

        <!-- Trust indicators -->
        <div class="flex flex-wrap sm:flex-nowrap gap-2.5 sm:gap-3 shrink-0 w-full sm:w-auto">
          {[
            { val: '27', unit: 'cu ft / yd³', label: 'ASTM Standard' },
            { val: '14+', unit: 'materials', label: 'Verified Densities' },
            { val: '6', unit: 'calculators', label: 'Trade Tools' },
          ].map(stat => (
            <div class="flex-1 sm:flex-initial bg-slate-800/90 border border-slate-700/80 rounded-xl px-3.5 sm:px-4 py-2.5 sm:py-3 text-center min-w-[75px] sm:min-w-[90px] shadow-xs">
              <div class="text-base sm:text-lg font-black text-white font-mono">{stat.val}</div>
              <div class="text-[10px] text-emerald-400 font-bold uppercase tracking-wider">{stat.unit}</div>
              <div class="text-[10px] text-slate-300 font-medium mt-0.5">{stat.label}</div>
            </div>
          ))}
        </div>
      </div>
    </div>

    <!-- Primary Interactive Island -->
    <div class="mb-12 sm:mb-16">
      <CubicYardCalculator client:load />
    </div>

    <!-- Specialized Material Calculators Bento Grid -->
    <div class="mb-16">
      <div class="flex items-center justify-between mb-5">
        <div>
          <h2 class="text-xl font-bold text-slate-900">Specialized Material Calculators</h2>
          <p class="text-xs text-slate-500 mt-0.5">Need certified quarry aggregate weights, CMU wall schedules, or bagged ready-mix counts? Select a specialized tool:</p>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {toolCards.map(card => (
          <a
            href={card.href}
            class={`group p-5 bg-white rounded-xl border-t-4 border border-slate-200 card-interactive ${card.accentColor}`}
          >
            <div class="flex items-start justify-between mb-3">
              <div class={`w-9 h-9 rounded-lg ${card.iconBg} flex items-center justify-center`}>
                <svg class={`w-5 h-5 ${card.iconColor}`} fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <Fragment set:html={card.icon} />
                </svg>
              </div>
              <span class="text-[10px] font-semibold bg-slate-100 text-slate-600 px-2 py-0.5 rounded-full">{card.badge}</span>
            </div>
            <span class={`text-sm font-bold text-slate-900 ${card.hoverText} transition-colors`}>{card.title}</span>
            <p class="text-xs text-slate-500 leading-relaxed mt-1">
              {card.desc}
            </p>
          </a>
        ))}
      </div>
    </div>

    <!-- Quick Navigation Anchor Strip -->
    <div class="bg-white border border-slate-200 rounded-xl p-3.5 mb-12 shadow-2xs overflow-x-auto text-xs font-semibold text-slate-600 flex items-center gap-2 whitespace-nowrap">
      <span class="text-slate-400 font-bold uppercase tracking-wider text-[10px] mr-1">Contents:</span>
      <a href="#geometry" class="px-2.5 py-1 rounded-md hover:bg-slate-100 hover:text-slate-900 transition-colors">1. Geometry & Formula</a>
      <span class="text-slate-300">·</span>
      <a href="#irregular-shapes" class="px-2.5 py-1 rounded-md hover:bg-slate-100 hover:text-slate-900 transition-colors">2. Irregular Footprints</a>
      <span class="text-slate-300">·</span>
      <a href="#density-index" class="px-2.5 py-1 rounded-md hover:bg-slate-100 hover:text-slate-900 transition-colors">3. Master Density Index</a>
      <span class="text-slate-300">·</span>
      <a href="#geotechnical" class="px-2.5 py-1 rounded-md hover:bg-slate-100 hover:text-slate-900 transition-colors">4. Bank vs Loose vs Compacted</a>
      <span class="text-slate-300">·</span>
      <a href="#hauling-logistics" class="px-2.5 py-1 rounded-md hover:bg-slate-100 hover:text-slate-900 transition-colors">5. Dump Truck Hauling</a>
      <span class="text-slate-300">·</span>
      <a href="#contractor-scenarios" class="px-2.5 py-1 rounded-md hover:bg-slate-100 hover:text-slate-900 transition-colors">6. Field Scenarios</a>
      <span class="text-slate-300">·</span>
      <a href="#waste-matrix" class="px-2.5 py-1 rounded-md hover:bg-slate-100 hover:text-slate-900 transition-colors">7. Waste Factors</a>
      <span class="text-slate-300">·</span>
      <a href="#faq" class="px-2.5 py-1 rounded-md hover:bg-slate-100 hover:text-slate-900 transition-colors">8. Construction FAQs</a>
    </div>

    <!-- Editorial Core Sections -->
    <div class="space-y-12 mb-16">

      <!-- SECTION 1: The Geometry of a Cubic Yard -->
      <section id="geometry" class="bg-white p-6 sm:p-8 rounded-2xl border border-slate-200 shadow-2xs space-y-5 scroll-mt-20">
        <div class="border-b border-slate-100 pb-4">
          <span class="text-[11px] font-bold text-emerald-700 bg-emerald-50 px-2.5 py-1 rounded-md uppercase tracking-wider">Engineering Fundamentals</span>
          <h2 class="text-2xl font-black text-slate-900 mt-2">The Geometry of a Cubic Yard: Mathematical Dimensional Analysis</h2>
        </div>

        <p class="text-sm text-slate-700 leading-relaxed">
          In US commercial construction, landscape estimating, and earthmoving logistics, the <strong>cubic yard</strong> (abbreviated as <code class="text-xs font-mono bg-slate-100 px-1.5 py-0.5 rounded text-slate-800">yd³</code> or <code class="text-xs font-mono bg-slate-100 px-1.5 py-0.5 rounded text-slate-800">cu yd</code>) is the standard unit of volumetric commerce. A cubic yard represents the three-dimensional space enclosed within an equilateral cube measuring exactly <strong>3 feet (36 inches) wide, 3 feet long, and 3 feet deep</strong>.
        </p>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-3.5 my-4">
          <div class="p-4 bg-slate-50 rounded-xl border border-slate-200">
            <span class="text-xs font-semibold text-slate-500 uppercase tracking-wider block">Imperial Foot Equivalent</span>
            <div class="text-xl font-bold font-mono text-slate-900 mt-1">27 cu ft</div>
            <p class="text-xs text-slate-600 mt-1">3 ft × 3 ft × 3 ft = exactly 27 cubic feet.</p>
          </div>
          <div class="p-4 bg-slate-50 rounded-xl border border-slate-200">
            <span class="text-xs font-semibold text-slate-500 uppercase tracking-wider block">Imperial Inch Equivalent</span>
            <div class="text-xl font-bold font-mono text-slate-900 mt-1">46,656 cu in</div>
            <p class="text-xs text-slate-600 mt-1">36 in × 36 in × 36 in = 46,656 cubic inches.</p>
          </div>
          <div class="p-4 bg-slate-50 rounded-xl border border-slate-200">
            <span class="text-xs font-semibold text-slate-500 uppercase tracking-wider block">SI Metric Equivalent</span>
            <div class="text-xl font-bold font-mono text-slate-900 mt-1">0.76455 m³</div>
            <p class="text-xs text-slate-600 mt-1">Exact SI conversion factor (764.55 liters).</p>
          </div>
        </div>

        <h3 class="text-lg font-bold text-slate-900 pt-2">The Dimensional Mismatch Trap: Why Divide by 27?</h3>
        <p class="text-sm text-slate-700 leading-relaxed">
          The most prevalent calculation error encountered on jobsites stems from unit inconsistency. On physical job sites, plan dimensions (length and width) are surveyed in <strong>feet</strong>, whereas excavation depths, concrete slab thicknesses, and gravel sub-bases are surveyed with tape measures in <strong>inches</strong> (e.g., a 4-inch sidewalk, 6-inch base, or 2-inch topdressing).
        </p>
        <p class="text-sm text-slate-700 leading-relaxed">
          Multiplying length in feet by width in feet by depth in inches directly without unit conversion corrupts the volume by a factor of 12 (1,200% over-calculation). Depth must always be normalized to feet prior to computing cubic footage:
        </p>

        <div class="bg-slate-900 text-white p-5 rounded-xl space-y-3 font-mono">
          <div class="text-xs font-bold uppercase tracking-wider text-emerald-400">Standard Dimensional Equations</div>
          <div class="text-sm sm:text-base font-bold text-white bg-slate-800/80 p-3 rounded-lg border border-slate-700">
            Cubic Yards = [ Length (ft) × Width (ft) × ( Depth (in) ÷ 12 ) ] ÷ 27
          </div>
          <div class="text-xs text-slate-300 leading-relaxed font-sans">
            <strong>The Direct Estimator's Shortcut:</strong> Because <span class="font-mono text-emerald-300">12 × 27 = 324</span>, estimators simplify this two-step arithmetic into a single operation:
          </div>
          <div class="text-sm sm:text-base font-bold text-emerald-300 bg-slate-800/80 p-3 rounded-lg border border-slate-700">
            Cubic Yards = ( Length in ft × Width in ft × Depth in inches ) ÷ 324
          </div>
        </div>

        <p class="text-xs text-slate-600 italic">
          *Note: The 324 divisor represents the fundamental coverage theorem of material estimating: exactly 1 cubic yard of any substance will coat 324 square feet of surface area at a depth of exactly 1 inch.
        </p>
      </section>

      <!-- SECTION 2: Geometric Formulas for Irregular Footprints -->
      <section id="irregular-shapes" class="bg-white p-6 sm:p-8 rounded-2xl border border-slate-200 shadow-2xs space-y-5 scroll-mt-20">
        <div class="border-b border-slate-100 pb-4">
          <span class="text-[11px] font-bold text-emerald-700 bg-emerald-50 px-2.5 py-1 rounded-md uppercase tracking-wider">Geometric Profiles</span>
          <h2 class="text-2xl font-black text-slate-900 mt-2">Formulas for Irregular Footprints, Columns & Swales</h2>
        </div>

        <p class="text-sm text-slate-700 leading-relaxed">
          Civil earthwork and architectural hardscaping rarely conform solely to perfect rectangles. Estimating volume for sonotube piers, circular pads, drainage trenches, and graded swales requires dedicated geometric formulas. Always convert all constituent measurements to feet before computing:
        </p>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <!-- Cylinder / Sonotube -->
          <div class="p-4 bg-slate-50 rounded-xl border border-slate-200 space-y-2">
            <div class="flex items-center justify-between">
              <span class="text-xs font-bold text-slate-900">Cylindrical Columns & Post Holes</span>
              <span class="text-[10px] font-mono bg-blue-100 text-blue-800 font-bold px-1.5 py-0.5 rounded">Sonotubes</span>
            </div>
            <p class="text-xs text-slate-600">
              For cylindrical concrete piers, fence posts, and columnar footings:
            </p>
            <div class="bg-slate-900 text-emerald-400 p-2.5 rounded-lg text-xs font-mono font-bold">
              Volume (yd³) = [ π × (Radius ft)² × Depth ft ] ÷ 27
            </div>
            <p class="text-[11px] text-slate-500">
              Example: A 12-inch diameter sonotube (0.5 ft radius) at 4 feet frost depth = [3.14159 × (0.5)² × 4] ÷ 27 = <strong>0.116 cu yds</strong>.
            </p>
          </div>

          <!-- Circular Pad -->
          <div class="p-4 bg-slate-50 rounded-xl border border-slate-200 space-y-2">
            <div class="flex items-center justify-between">
              <span class="text-xs font-bold text-slate-900">Circular Fire Pits & Tree Rings</span>
              <span class="text-[10px] font-mono bg-green-100 text-green-800 font-bold px-1.5 py-0.5 rounded">Circles</span>
            </div>
            <p class="text-xs text-slate-600">
              For circular patios, round fire pit pads, and mulch rings around trees:
            </p>
            <div class="bg-slate-900 text-emerald-400 p-2.5 rounded-lg text-xs font-mono font-bold">
              Volume (yd³) = [ π × (Diameter ft ÷ 2)² × (Depth in ÷ 12) ] ÷ 27
            </div>
            <p class="text-[11px] text-slate-500">
              Example: A 14-foot diameter round patio with 3 inches of gravel base = [3.14159 × 7² × (3 ÷ 12)] ÷ 27 = <strong>1.425 cu yds</strong>.
            </p>
          </div>

          <!-- Triangular Berm / French Drain -->
          <div class="p-4 bg-slate-50 rounded-xl border border-slate-200 space-y-2">
            <div class="flex items-center justify-between">
              <span class="text-xs font-bold text-slate-900">Triangular Trenches & French Drains</span>
              <span class="text-[10px] font-mono bg-amber-100 text-amber-800 font-bold px-1.5 py-0.5 rounded">V-Ditches</span>
            </div>
            <p class="text-xs text-slate-600">
              For V-notch drainage swales, berm backfills, and triangular soil cuts:
            </p>
            <div class="bg-slate-900 text-emerald-400 p-2.5 rounded-lg text-xs font-mono font-bold">
              Volume (yd³) = [ 0.5 × Base ft × Depth ft × Length ft ] ÷ 27
            </div>
            <p class="text-[11px] text-slate-500">
              Example: A 100-foot trench, 2 feet wide at top, tapering to base at 1.5 feet depth = [0.5 × 2 × 1.5 × 100] ÷ 27 = <strong>5.56 cu yds</strong>.
            </p>
          </div>

          <!-- Trapezoidal Swale -->
          <div class="p-4 bg-slate-50 rounded-xl border border-slate-200 space-y-2">
            <div class="flex items-center justify-between">
              <span class="text-xs font-bold text-slate-900">Trapezoidal Swales & Retention Channels</span>
              <span class="text-[10px] font-mono bg-purple-100 text-purple-800 font-bold px-1.5 py-0.5 rounded">Channels</span>
            </div>
            <p class="text-xs text-slate-600">
              For flat-bottomed drainage channels with sloped banks:
            </p>
            <div class="bg-slate-900 text-emerald-400 p-2.5 rounded-lg text-xs font-mono font-bold">
              Volume (yd³) = [ ((Top Width + Bottom Width) ÷ 2) × Depth × Length ] ÷ 27
            </div>
            <p class="text-[11px] text-slate-500">
              Example: 8 ft top, 4 ft bottom, 2 ft depth, 50 ft length = [((8 + 4) ÷ 2) × 2 × 50] ÷ 27 = <strong>22.22 cu yds</strong>.
            </p>
          </div>
        </div>
      </section>


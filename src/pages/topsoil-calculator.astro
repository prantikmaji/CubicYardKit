---
import BaseLayout from '../layouts/BaseLayout.astro';
import TopsoilCalculator from '../components/calc/TopsoilCalculator';
import Breadcrumbs from '../components/seo/Breadcrumbs.astro';
import SavedProjectsIsland from '../components/storage/SavedProjectsIsland';
import RelatedCalculators from '../components/layout/RelatedCalculators.astro';

const seo = {
  title: 'Topsoil Calculator | Yards & Square Feet Coverage | CubicYardKit',
  description:
    'Calculate topsoil volume in cubic yards, bags, and square feet coverage. Agronomic application depths for new sod, lawn leveling, overseeding, and raised garden beds.',
  canonicalUrl: 'https://cubicyardkit.com/topsoil-calculator/',
};

const faqs = [
  {
    question: 'How do I calculate how much topsoil I need for my lawn or garden?',
    answer:
      'Measure length and width in feet to determine square footage. Multiply square footage by your desired depth in inches, then divide by 324 to calculate cubic yards: (Square Feet × Depth in Inches) ÷ 324 = Cubic Yards. For example, a 1,200 sq ft lawn needing 2 inches of topsoil requires (1,200 × 2) ÷ 324 = 7.41 cubic yards. Add a 10% to 15% allowance to compensate for settling after initial watering.',
  },
  {
    question: 'How many square feet does 1 cubic yard of topsoil cover?',
    answer:
      'One cubic yard of topsoil covers exactly 324 square feet at 1 inch depth, 162 square feet at 2 inches depth, 108 square feet at 3 inches depth, 81 square feet at 4 inches depth, and 54 square feet at 6 inches depth. To calculate square foot coverage at any custom depth, simply divide 324 by your depth in inches (e.g., 324 ÷ 1.5 inches = 216 sq ft).',
  },
  {
    question: 'How deep should topsoil be for laying fresh sod or planting grass seed?',
    answer:
      'For new sod establishment or planting grass seed on a bare yard, civil landscape specifications require a minimum of 4 to 6 inches of rich, screened sandy loam topsoil over loosened subgrade. This provides adequate root zone depth for turf roots to penetrate deep into the profile, making the lawn resilient against summer drought heat stress.',
  },
  {
    question: 'How much topsoil do I need for lawn topdressing over existing grass?',
    answer:
      'For topdressing established turfgrass after core aeration, apply a thin layer of 1/4 to 1/2 inch of finely screened topsoil (or a 50/50 topsoil and compost blend). Never apply more than 1/2 inch at a single application, as burying grass crown nodes deeper than 1/2 inch will suffocate and kill living turf blades.',
  },
  {
    question: 'How many bags of topsoil make 1 cubic yard?',
    answer:
      'Retail topsoil bags are sold by cubic volume: one 1.0-cubic-foot bag requires 27 bags to equal 1 cubic yard (27 ÷ 1.0). For 0.75-cubic-foot bags, you need 36 bags. For 40-lb or 50-lb weight-rated bags, you typically need 42 to 50 bags per cubic yard depending on moisture content. For projects exceeding 2 cubic yards, bulk delivery is significantly more cost-effective.',
  },
  {
    question: 'How much does a cubic yard of screened topsoil weigh?',
    answer:
      'Dry, screened sandy loam topsoil weighs approximately 2,000 to 2,200 pounds (1.0 to 1.1 US tons) per cubic yard. When wet or saturated with rainwater, weight increases to 2,400 to 2,600 pounds (1.2 to 1.3 tons) per cubic yard. Topsoil blends enriched with high compost ratios are lighter, weighing 1,600 to 1,900 lbs/yd³.',
  },
  {
    question: 'What is the difference between screened topsoil and garden blend soil?',
    answer:
      'Standard screened topsoil is native mineral subgrade sifted through a mechanical trommel screen to remove rocks and clods larger than 1/2 inch. Garden blend (or planter mix) is an engineered soil recipe combining roughly 60% screened topsoil, 30% organic compost (or mushroom compost), and 10% coarse sand or perlite to maximize microbial fertility and aeration for vegetable roots.',
  },
  {
    question: 'Why does fresh topsoil settle after spreading and watering?',
    answer:
      'When soil is excavated and mechanically shredded through a screening trommel, it becomes aerated and "fluffed" up to 125% of its natural density. Upon first rain or hose irrigation, water pulls the loose soil particles together, settling the bed by 15% to 20%. Always rake topsoil slightly above surrounding grade before rolling or seeding.',
  },
];
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  canonicalUrl={seo.canonicalUrl}
  faqs={faqs}
  breadcrumbs={[{ name: 'Topsoil Calculator', item: seo.canonicalUrl }]}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-5 sm:pt-7 pb-14 sm:pb-20">
    <Breadcrumbs items={[{ name: 'Topsoil Calculator' }]} />

    <!-- Hero Banner — High contrast dark slate with emerald aura -->
    <div class="relative overflow-hidden rounded-2xl sm:rounded-3xl bg-slate-900 border border-slate-800 px-6 sm:px-8 lg:px-10 py-7 sm:py-9 lg:py-10 mb-8 sm:mb-10 text-white shadow-md">
      <div class="absolute -top-12 -right-12 w-96 h-96 bg-emerald-500/10 rounded-full blur-3xl pointer-events-none"></div>

      <div class="relative flex flex-wrap items-end justify-between gap-6 lg:gap-8">
        <div class="max-w-2xl">
          <div class="inline-flex items-center gap-2 bg-emerald-950/80 border border-emerald-500/40 rounded-full px-3.5 py-1 text-xs font-bold text-emerald-300 mb-3.5 sm:mb-4 shadow-xs">
            <span class="w-1.5 h-1.5 bg-emerald-400 rounded-full animate-pulse shadow-[0_0_8px_#34d399]"></span>
            Agronomic Soil Profiles · Trommel Screen Specs · Turf & Garden Coverage
          </div>

          <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black text-white tracking-tight leading-[1.08] mb-2.5 sm:mb-3">
            Topsoil Calculator
          </h1>
          <p class="text-sm sm:text-base text-slate-200 max-w-xl leading-relaxed">
            Calculate topsoil volume in cubic yards, retail bags, and square feet coverage. Master agronomic application depths for lawn renovation, sod preparation, overseeding, and raised garden planter mixes.
          </p>
        </div>

        <!-- Trust indicators -->
        <div class="flex flex-wrap sm:flex-nowrap gap-2.5 sm:gap-3 shrink-0 w-full sm:w-auto">
          {[
            { val: '324', unit: 'sq ft', label: 'Coverage @ 1" Depth' },
            { val: '27', unit: 'bags/yd³', label: '1.0 cu ft Retail Bags' },
            { val: '2,100', unit: 'lb/yd³', label: 'Screened Loam' },
            { val: '4" to 6"', unit: 'depth', label: 'New Sod Prep' },
          ].map(stat => (
            <div class="flex-1 sm:flex-initial bg-slate-800/90 border border-slate-700/80 rounded-xl px-3.5 sm:px-4 py-2.5 sm:py-3 text-center min-w-[75px] sm:min-w-[90px] shadow-xs">
              <div class="text-base sm:text-lg font-black text-white font-mono">{stat.val}</div>
              <div class="text-[10px] text-emerald-400 font-bold uppercase tracking-wider">{stat.unit}</div>
              <div class="text-[10px] text-slate-300 font-medium mt-0.5">{stat.label}</div>
            </div>
          ))}
        </div>
      </div>
    </div>

    <!-- Interactive Island -->
    <div class="mb-12 sm:mb-16">
      <TopsoilCalculator client:load />
    </div>

    <!-- Educational Content & Engineering Breakdown -->
    <div class="space-y-12 mb-16">

      <!-- SECTION 1: How to Calculate Topsoil -->
      <section class="bg-white p-6 sm:p-8 rounded-2xl border border-slate-200 shadow-2xs space-y-5">
        <div class="border-b border-slate-100 pb-4">
          <span class="text-[11px] font-bold text-emerald-700 bg-emerald-50 px-2.5 py-1 rounded-md uppercase tracking-wider">Volumetric Coverage</span>
          <h2 class="text-2xl font-black text-slate-900 mt-2">How to Calculate Topsoil: Square Feet to Cubic Yards</h2>
        </div>

        <p class="text-sm text-slate-700 leading-relaxed">
          Estimating topsoil requires measuring your total project square footage and dividing by the mathematical coverage constant of a cubic yard. One cubic yard contains 27 cubic feet, which equals exactly <strong>324 square feet at a 1-inch thickness</strong> (27 × 12 = 324):
        </p>

        <div class="bg-slate-900 text-white p-5 rounded-xl space-y-3 font-mono text-xs">
          <div class="text-emerald-400 font-bold uppercase tracking-wider">Universal Topsoil Coverage Formula</div>
          <div class="text-sm sm:text-base font-bold bg-slate-800/80 p-3 rounded-lg border border-slate-700">
            Cubic Yards = ( Total Square Feet × Depth in Inches ) ÷ 324
          </div>
          <div class="text-xs text-slate-300 leading-relaxed font-sans">
            Add a <strong>12% to 15% fluff settlement factor</strong> when calculating loose screened topsoil, as irrigation and raking naturally compact the aerated soil profile.
          </div>
        </div>

        <h3 class="text-lg font-bold text-slate-900 pt-2">Worked Contractor Example: 2,400 Sq Ft Lawn Renovation at 3" Depth</h3>
        <p class="text-sm text-slate-700 leading-relaxed">
          Suppose a landscaping contractor is preparing a <strong>2,400 square foot</strong> residential yard for hydroseeding, requiring a <strong>3-inch layer</strong> of screened loam:
        </p>
        <ol class="list-decimal list-inside text-sm text-slate-700 space-y-1.5 pl-2 font-medium">
          <li>Calculate net geometric volume: <span class="font-mono text-slate-900">(2,400 sq ft × 3 in) ÷ 324 = 22.22 cu yds</span></li>
          <li>Add 12% fluff and settling factor: <span class="font-mono text-slate-900">22.22 × 1.12 = 24.89 cu yds</span></li>
          <li>Convert to certified scale weight (2,100 lb/yd³): <span class="font-mono text-slate-900">24.89 yds × 1.05 tons/yd = 26.13 Tons</span></li>
          <li>Delivery sizing: <span class="font-mono text-slate-900">24.89 yds ÷ 12 yds/truck = 2 Tandem dump truckloads</span></li>
          <li>Packaged bag equivalent (if purchasing 1.0 cu ft retail bags): <span class="font-mono text-slate-900">24.89 yds × 27 bags/yd = 672 bags</span></li>
        </ol>
      </section>

      <!-- SECTION 2: Agronomic Depth Matrix -->
      <section class="bg-white p-6 sm:p-8 rounded-2xl border border-slate-200 shadow-2xs space-y-5">
        <div class="border-b border-slate-100 pb-4">
          <span class="text-[11px] font-bold text-emerald-700 bg-emerald-50 px-2.5 py-1 rounded-md uppercase tracking-wider">Agronomic Standards</span>
          <h2 class="text-2xl font-black text-slate-900 mt-2">Recommended Topsoil Depths by Project Application</h2>
        </div>

        <p class="text-sm text-slate-700 leading-relaxed">
          Applying incorrect soil depth can lead to root suffocating or summer drought desiccation. Match your project depth to agronomic turfgrass standards:
        </p>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
          <div class="p-4 bg-slate-50 rounded-xl border border-slate-200 space-y-2">
            <span class="text-[10px] font-mono font-bold bg-green-100 text-green-900 px-2 py-0.5 rounded uppercase">Turf Maintenance</span>
            <div class="text-sm font-bold text-slate-900">Core Aeration Topdressing</div>
            <div class="text-emerald-700 font-mono font-bold text-xs">1/4" to 1/2" Depth</div>
            <p class="text-xs text-slate-600 leading-relaxed">
              1 cu yd covers <strong>648 to 1,296 sq ft</strong>. Spread across existing lawns after pulling aerator cores. Enriches the root zone with microbes without suffocating grass leaves.
            </p>
          </div>

          <div class="p-4 bg-slate-50 rounded-xl border border-slate-200 space-y-2">
            <span class="text-[10px] font-mono font-bold bg-green-100 text-green-900 px-2 py-0.5 rounded uppercase">Turf Renovation</span>
            <div class="text-sm font-bold text-slate-900">Overseeding & Leveling</div>
            <div class="text-emerald-700 font-mono font-bold text-xs">1" to 2" Depth</div>
            <p class="text-xs text-slate-600 leading-relaxed">
              1 cu yd covers <strong>162 to 324 sq ft</strong>. Eliminates scalping high spots, smooths bumpy mower ruts, and provides an ideal seed-to-soil bed for newly broadcasted fescue or bluegrass.
            </p>
          </div>

          <div class="p-4 bg-slate-50 rounded-xl border border-slate-200 space-y-2">
            <span class="text-[10px] font-mono font-bold bg-green-100 text-green-900 px-2 py-0.5 rounded uppercase">New Establishment</span>
            <div class="text-sm font-bold text-slate-900">Fresh Sod & New Lawn</div>
            <div class="text-emerald-700 font-mono font-bold text-xs">4" to 6" Depth</div>
            <p class="text-xs text-slate-600 leading-relaxed">
              1 cu yd covers <strong>54 to 81 sq ft</strong>. Creates deep root reservoirs. Shallow soil (under 3 inches) results in rapid turf burnout and sod shrinkage during summer heat.
            </p>
          </div>

          <div class="p-4 bg-slate-50 rounded-xl border border-slate-200 space-y-2">
            <span class="text-[10px] font-mono font-bold bg-green-100 text-green-900 px-2 py-0.5 rounded uppercase">Horticulture</span>
            <div class="text-sm font-bold text-slate-900">Raised Garden Planters</div>
            <div class="text-emerald-700 font-mono font-bold text-xs">8" to 12" Depth</div>
            <p class="text-xs text-slate-600 leading-relaxed">
              1 cu yd covers <strong>27 to 40 sq ft</strong>. Provides unrestricted taproot depth for heavy-feeding vegetables (tomatoes, carrots, peppers). Requires an aerated 60/30/10 blend.
            </p>
          </div>
        </div>
      </section>

      <!-- SECTION 3: Screen Specs & Trommel Classification -->
      <section class="bg-white p-6 sm:p-8 rounded-2xl border border-slate-200 shadow-2xs space-y-5">
        <div class="border-b border-slate-100 pb-4">
          <span class="text-[11px] font-bold text-emerald-700 bg-emerald-50 px-2.5 py-1 rounded-md uppercase tracking-wider">Quality Specifications</span>
          <h2 class="text-2xl font-black text-slate-900 mt-2">Screened Topsoil Grades & Trommel Sizing</h2>
        </div>

        <p class="text-sm text-slate-700 leading-relaxed">
          Not all bulk topsoil is created equal. Commercial landscape yards pass raw field soil through rotating mechanical trommel screens to separate usable loam from debris:
        </p>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 text-xs text-slate-700">
          <div class="p-4 bg-slate-50 rounded-xl border border-slate-200 space-y-2">
            <span class="font-bold text-slate-900 block text-sm">1/2-Inch Screened Loam</span>
            <span class="text-[10px] font-mono text-emerald-700 font-bold block">Standard General Purpose</span>
            <p class="text-slate-600 leading-relaxed">
              Removes rocks, sticks, and clay clods larger than 0.5 inches. The most common and economical grade for broad lawn leveling, tree planting, and filling subgrade grading trenches.
            </p>
          </div>

          <div class="p-4 bg-slate-50 rounded-xl border border-slate-200 space-y-2">
            <span class="font-bold text-slate-900 block text-sm">3/8-Inch Finely Screened Loam</span>
            <span class="text-[10px] font-mono text-emerald-700 font-bold block">Premium Sod & Turf Grade</span>
            <p class="text-slate-600 leading-relaxed">
              Sifted through tighter wire mesh. Extremely smooth texture that rakes effortlessly with landscape lutes. Ideal for sod underlayment, seed broadcasting, and residential flower beds.
            </p>
          </div>

          <div class="p-4 bg-slate-50 rounded-xl border border-slate-200 space-y-2">
            <span class="font-bold text-slate-900 block text-sm">Enriched 60/30/10 Garden Blend</span>
            <span class="text-[10px] font-mono text-emerald-700 font-bold block">Engineered Planter Mix</span>
            <p class="text-slate-600 leading-relaxed">
              Composed of 60% finely screened sandy loam, 30% aged organic compost, and 10% coarse sand. Prevents soil compaction in raised containers, promoting exceptional water drainage and root oxygenation.
            </p>
          </div>
        </div>
      </section>

      <!-- SECTION 4: Bagged vs Bulk Delivery Economics -->
      <section class="bg-white p-6 sm:p-8 rounded-2xl border border-slate-200 shadow-2xs space-y-5">
        <div class="border-b border-slate-100 pb-4">
          <span class="text-[11px] font-bold text-emerald-700 bg-emerald-50 px-2.5 py-1 rounded-md uppercase tracking-wider">Logistics & Budget</span>
          <h2 class="text-2xl font-black text-slate-900 mt-2">Bagged Topsoil vs. Bulk Dump Truck Delivery: Cost Analysis</h2>
        </div>

        <p class="text-sm text-slate-700 leading-relaxed">
          Pre-bagged topsoil sold at home centers is convenient for small pot planting, but purchasing bags for lawn projects is financially inefficient:
        </p>

        <div class="overflow-x-auto rounded-xl border border-slate-200">
          <table class="w-full text-xs text-left">
            <thead class="bg-slate-900 text-white font-bold">
              <tr>
                <th class="px-3.5 py-2.5">Project Volume</th>
                <th class="px-3 py-2.5 text-right">1.0 cu ft Bags Needed</th>
                <th class="px-3 py-2.5 text-right">Bagged Cost (@ $3.50/bag)</th>
                <th class="px-3 py-2.5 text-right">Bulk Nursery Cost + Delivery</th>
                <th class="px-3.5 py-2.5 text-center font-bold text-emerald-400">Best Buying Option</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100 text-slate-700">
              <tr>
                <td class="px-3.5 py-2 font-bold text-slate-900">0.5 cu yd (13.5 cu ft)</td>
                <td class="px-3 py-2 text-right font-mono">14 bags</td>
                <td class="px-3 py-2 text-right font-mono font-medium">$49.00</td>
                <td class="px-3 py-2 text-right font-mono text-slate-500">$95.00 (min drop fee)</td>
                <td class="px-3.5 py-2 text-center font-bold text-slate-700">Retail Bags (Car Trunk)</td>
              </tr>
              <tr class="bg-slate-50/50">
                <td class="px-3.5 py-2 font-bold text-slate-900">1.0 cu yd (27 cu ft)</td>
                <td class="px-3 py-2 text-right font-mono">27 bags</td>
                <td class="px-3 py-2 text-right font-mono font-medium">$94.50</td>
                <td class="px-3 py-2 text-right font-mono text-slate-500">$105.00</td>
                <td class="px-3.5 py-2 text-center font-bold text-slate-700">Break-Even / Pickup Bed</td>
              </tr>
              <tr>
                <td class="px-3.5 py-2 font-bold text-slate-900">3.0 cu yds (81 cu ft)</td>
                <td class="px-3 py-2 text-right font-mono">81 bags</td>
                <td class="px-3 py-2 text-right font-mono font-medium text-rose-700">$283.50</td>
                <td class="px-3 py-2 text-right font-mono font-bold text-emerald-700">$175.00</td>
                <td class="px-3.5 py-2 text-center font-bold text-emerald-700">Bulk Delivery (Save $108)</td>
              </tr>
              <tr class="bg-slate-50/50">
                <td class="px-3.5 py-2 font-bold text-slate-900">10.0 cu yds (Tandem Load)</td>
                <td class="px-3 py-2 text-right font-mono">270 bags</td>
                <td class="px-3 py-2 text-right font-mono font-medium text-rose-700">$945.00</td>
                <td class="px-3 py-2 text-right font-mono font-bold text-emerald-700">$450.00</td>
                <td class="px-3.5 py-2 text-center font-bold text-emerald-700">Commercial Tandem (Save $495)</td>
              </tr>
            </tbody>
          </table>
        </div>
      </section>

      <!-- SECTION 5: FAQs -->
      <section class="space-y-6">
        <div>
          <span class="text-[11px] font-bold text-emerald-700 bg-emerald-50 px-2.5 py-1 rounded-md uppercase tracking-wider">Agronomic FAQs</span>
          <h2 class="text-2xl font-black text-slate-900 mt-1">Topsoil Calculator FAQs</h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          {faqs.map((faq) => (
            <div class="bg-white p-5 rounded-xl border border-slate-200 shadow-2xs">
              <h3 class="font-bold text-slate-900 text-sm mb-2">{faq.question}</h3>
              <p class="text-xs text-slate-600 leading-relaxed">{faq.answer}</p>
            </div>
          ))}
        </div>
      </section>

      <!-- Cross-Calculator Link Matrix -->
      <RelatedCalculators currentPath={seo.canonicalUrl} />

    </div>
  </div>
</BaseLayout>
